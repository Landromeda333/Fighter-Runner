<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/UI/Styles/MainMenu.uss?fileID=7433441132597879392&amp;guid=cee43ef97af43164ab0532eb8fb28675&amp;type=3#MainMenu"/>
    <ui:Image source="project://database/Assets/Project/Textures/Sprites/Infinity%20Runner%20Background%20Menu.png?fileID=2800000&amp;guid=07467b7f52bd82e46a53e179c5eafadc&amp;type=3#Infinity Runner Background Menu" style="height: 100%;">
        <ui:Button name="settings-button" style="align-self: flex-end; background-image: url(&quot;project://database/Assets/Project/Textures/Sprites/Buttons/BTNs/Settings_BTN.png?fileID=2800000&amp;guid=295936b3b20666d47810a5313e9d4d95&amp;type=3#Settings_BTN&quot;); -unity-background-scale-mode: scale-and-crop; width: 8%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(188, 188, 188, 0); height: 14%; right: 3%; top: 4%;"/>
        <ui:Image source="" style="background-image: url(&quot;project://database/Assets/Project/Textures/Sprites/Window.png?fileID=2800000&amp;guid=d7895abf68d679844a018fe5a9ec904e&amp;type=3#Window&quot;); height: 610px; width: 476px; background-size: 100% 100%; position: relative; align-self: center; bottom: -314px; justify-content: space-evenly; align-items: center;">
            <ui:Label text="Fighter Runner" name="title-text" style="color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 50px; height: 31px; margin-top: 16px; -unity-text-align: lower-right;"/>
            <ui:Button text="Jugar" name="play-button" style="background-image: url(&quot;project://database/Assets/Project/Textures/Sprites/Price_BTN_Table.png?fileID=2800000&amp;guid=2ff3705282dfb314a965bb8485f3018d&amp;type=3#Price_BTN_Table&quot;); width: 60%; height: 23%; -unity-background-scale-mode: scale-to-fit; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 44px; -unity-text-align: middle-center; padding-top: 0;"/>
            <ui:Button text="Información" name="info-button" style="background-image: url(&quot;project://database/Assets/Project/Textures/Sprites/Price_BTN_Table.png?fileID=2800000&amp;guid=2ff3705282dfb314a965bb8485f3018d&amp;type=3#Price_BTN_Table&quot;); -unity-background-scale-mode: scale-to-fit; width: 50%; height: 16%; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 25px; padding-top: 0;"/>
            <ui:Button text="Salir" name="exit-button" style="background-image: url(&quot;project://database/Assets/Project/Textures/Sprites/Price_BTN_Table.png?fileID=2800000&amp;guid=2ff3705282dfb314a965bb8485f3018d&amp;type=3#Price_BTN_Table&quot;); background-color: rgba(188, 188, 188, 0); -unity-background-scale-mode: scale-to-fit; width: 50%; height: 16%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 25px; color: rgb(255, 255, 255); -unity-font-style: bold; padding-top: 0;"/>
        </ui:Image>
        <ui:Image source="project://database/Assets/Project/Textures/Sprites/Table.png?fileID=2800000&amp;guid=423d67d5e97476242a58ec12a92f1259&amp;type=3#Table" name="highscores-panel" style="position: absolute; top: 15%; height: 75%; width: 33%; right: auto; left: -34%; align-items: center;">
            <ui:Image source="project://database/Assets/Project/Textures/Sprites/Record.png?fileID=2800000&amp;guid=298954b3e48251548bb49d28985ceeaa&amp;type=3#Record" style="margin-top: 36px; margin-bottom: 36px;"/>
