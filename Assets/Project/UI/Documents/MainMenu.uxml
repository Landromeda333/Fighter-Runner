                <ui:Columns>
                    <ui:Column name="Position" title="Puesto" width="33%"/>
                    <ui:Column name="Score" title="Puntuación" width="33%"/>
                    <ui:Column name="Time" title="Tiempo" width="34%"/>
                </ui:Columns>
            </ui:MultiColumnListView>
            <ui:Button name="highscore-button" style="background-image: url(&quot;project://database/Assets/Project/Textures/Sprites/Buttons/BTNs/Forward_BTN.png?fileID=2800000&amp;guid=c5305b5f72cc19d44bf7f4c897063879&amp;type=3#Forward_BTN&quot;); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-background-scale-mode: scale-to-fit; width: 13%; height: 10%; left: 99%; top: 45%; position: absolute;"/>
        </ui:Image>
    </ui:Image>
</ui:UXML>
